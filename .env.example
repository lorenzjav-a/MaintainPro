# Configure these in the web server or PHP-FPM environment. Never commit .env.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://maintainpro.example.com
APP_VERSION=1.0.0
APP_FORCE_HTTPS=true
APP_TRUST_PROXY=false
APP_MAINTENANCE=false
APP_KEY=CHANGE_TO_AN_INDEPENDENT_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
APP_SETUP_KEY=CHANGE_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
SESSION_STAFF_TIMEOUT=2700
SESSION_RESIDENT_TIMEOUT=7200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=maintainpro
DB_USER=maintainpro_app
DB_PASSWORD=CHANGE_ME

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=maintainpro@example.com
