Options -Indexes
DirectoryIndex index.php
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)\.(?:log|sql|sqlite|db|bak|backup|dump|zip)(?:\.(?:gz|zip))?$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule "(^|/)\." "-" [F,L,NC]
# Browser dependencies in assets/vendor are public; only the root PHP vendor
# directory is private. Blocking every vendor segment breaks form submission.
RewriteRule "^vendor(?:/|$)" "-" [F,L,NC]
RewriteRule "(^|/)(?:includes|config|tools|tests|database|logs|backups|uploads)(?:/|$)" "-" [F,L,NC]
