Options -Indexes
DirectoryIndex index.php
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)\.(?:log|sql|sqlite|db|bak|backup|dump|zip)(?:\.(?:gz|zip))?$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)^(?:\.env(?:\..*)?|composer\.(?:json|lock)|phpunit\.xml|AGENTS\.md)$">
    Require all denied
</FilesMatch>

RewriteEngine On
# Canonicalize legacy invitation links before extension cleanup. Apache keeps
# the original query string, including the invitation token, on this redirect.
RewriteCond %{HTTP_HOST} ^maintainprosystem\.online$ [NC]
RewriteRule ^ https://www.maintainprosystem.online%{REQUEST_URI} [R=308,L,NE]

RewriteRule "(^|/)\." "-" [F,L,NC]
# Browser dependencies in assets/vendor are public; only the root PHP vendor
# directory is private. Blocking every vendor segment breaks form submission.
RewriteRule "^vendor(?:/|$)" "-" [F,L,NC]
RewriteRule "(^|/)(?:includes|config|tools|tests|database|logs|backups|uploads)(?:/|$)" "-" [F,L,NC]

# Keep page URLs extensionless. Only redirect browser page requests: POST
# endpoints such as api.php and auth.php must retain their request bodies.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ /%1 [R=301,L,NE]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]) [NC]
RewriteRule ^(.+)\.php$ /%1 [R=301,L,NE]

# Resolve extensionless application paths to their PHP entry points without
# exposing the implementation filename in the address bar.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
